# Client ID from your Web3Auth project (https://dashboard.web3auth.io).
# Enable the Algorand TestNet chain in the project's chain settings.
VITE_WEB3AUTH_CLIENT_ID=

# Web3Auth network of that project. Must match the client ID.
# One of: sapphire_devnet (default), sapphire_mainnet, mainnet, testnet, cyan, aqua
VITE_WEB3AUTH_NETWORK=sapphire_devnet
